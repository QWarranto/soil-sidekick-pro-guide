{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skyline mmWave Sensor Data Schema v2.0",
  "description": "Schema for Skyline Instruments mmWave sensor data ingestion - Major breaking changes in v2.0",
  "type": "object",
  "required": [
    "device_id",
    "firmware_version",
    "timestamp",
    "sensor_data",
    "calibration"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^SKY-[A-Z0-9]{8}-[A-Z0-9]{4}$",
      "description": "Unique device identifier in SKY-XXXXXXXX-XXXX format"
    },
    "firmware_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
      "description": "Device firmware version in semantic versioning format"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of sensor reading"
    },
    "sensor_data": {
      "type": "object",
      "required": [
        "frequency_ghz",
        "signal_power_db",
        "velocity_mps",
        "range_mm",
        "angle_deg",
        "tracked_targets"
      ],
      "properties": {
        "frequency_ghz": {
          "type": "number",
          "minimum": 24,
          "maximum": 81,
          "description": "mmWave frequency in GHz"
        },
        "signal_power_db": {
          "type": "number",
          "minimum": -120,
          "maximum": 0,
          "description": "Signal power in dBm"
        },
        "velocity_mps": {
          "type": "number",
          "minimum": -50,
          "maximum": 50,
          "description": "Velocity in meters per second"
        },
        "range_mm": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "description": "Range resolution in millimeters"
        },
        "angle_deg": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "Angular resolution in degrees"
        },
        "detected_targets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512,
          "description": "Number of detected targets"
        },
        "noise_level_db": {
          "type": "number",
          "minimum": -140,
          "maximum": -80,
          "description": "Noise level in dBm"
        },
        "interference_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Interference score (0-10)"
        },
        "tracked_targets": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id", "distance_m", "speed_mps", "azimuth_deg", "track_confidence"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^TGT-[0-9]{6}$",
                "description": "Target identifier in TGT-XXXXXX format"
              },
              "distance_m": {
                "type": "number",
                "minimum": 0,
                "maximum": 500,
                "description": "Target distance in meters"
              },
              "speed_mps": {
                "type": "number",
                "minimum": -100,
                "maximum": 100,
                "description": "Target speed in m/s"
              },
              "azimuth_deg": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "Target azimuth in degrees"
              },
              "elevation_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "description": "Target elevation in degrees"
              },
              "track_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Tracking confidence (0-1)"
              },
              "signal_quality": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Signal quality percentage"
              }
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": [
        "last_calibrated",
        "drift_percentage",
        "needs_calibration"
      ],
      "properties": {
        "last_calibrated": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last calibration"
        },
        "drift_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Calibration drift percentage"
        },
        "needs_calibration": {
          "type": "boolean",
          "description": "Flag indicating if calibration is needed"
        },
        "calibration_quality": {
          "type": "string",
          "enum": ["excellent", "good", "fair", "poor"],
          "description": "Calibration quality rating"
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "temp_c": {
          "type": "number",
          "minimum": -40,
          "maximum": 85,
          "description": "Temperature in Celsius"
        },
        "humidity_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Humidity percentage"
        },
        "rain_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Rainfall in millimeters"
        },
        "wind_mps": {
          "type": "number",
          "minimum": 0,
          "description": "Wind speed in m/s"
        },
        "visibility_m": {
          "type": "number",
          "minimum": 0,
          "description": "Visibility in meters"
        }
      }
    },
    "position": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number",
          "description": "Altitude in meters"
        }
      }
    },
    "device_metadata": {
      "type": "object",
      "required": ["transmission_id", "seq_num", "battery_pct"],
      "properties": {
        "transmission_id": {
          "type": "string",
          "description": "Unique transmission identifier"
        },
        "seq_num": {
          "type": "integer",
          "minimum": 0,
          "description": "Sequence number"
        },
        "battery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Battery percentage"
        },
        "signal_strength": {
          "type": "number",
          "minimum": -120,
          "maximum": 0,
          "description": "Signal strength in dBm"
        },
        "uptime_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Device uptime in seconds"
        }
      }
    }
  }
}